{
  "expo": {
    "name": "onthemuv",
    "slug": "zanosamu-digital-studio",
    "scheme": "onthemuv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zanosamu.onthemuv"
    },
    "android": {
      "package": "com.zanosamu.onthemuv",
      "adaptiveIcon": {
        "backgroundColor": "#08090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "onthemuv uses your location while GO LIVE is on so parents and admin can see this vehicle move.",
          "locationAlwaysAndWhenInUsePermission": "onthemuv uses your location, including while the app is in the background, so parents and admin can keep seeing this vehicle move during a live trip.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d868eb24-5b09-4c70-b36c-d0d3b2bf68ae"
      }
    },
    "owner": "zanosamu-digital-studio"
  }
}
